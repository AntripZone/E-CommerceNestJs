// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// schema.prisma — POS & E-commerce

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Enums
enum Rol {
  ADMIN
  CAJERO
}

enum CanalVenta {
  MOSTRADOR
  WEB
  MARKETPLACE
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  ENVIADA
  ENTREGADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CONTRA_ENTREGA
}

enum EstadoPago {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

enum TipoMovimiento {
  ENTRADA
  VENTA
  AJUSTE
  DEVOLUCION
  CANCELACION
}

//Catalogo e Inventario
model Categoria {
  id               Int      @id @default(autoincrement())
  categoriaPadreId Int?     @map("categoria_padre_id")
  nombre           String   @unique @db.VarChar(100)
  slug             String   @unique @db.VarChar(120)
  descripcion      String?  @db.Text
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  categoriaPadre Categoria?  @relation("Subcategorias", fields: [categoriaPadreId], references: [id], onDelete: SetNull)
  subcategorias  Categoria[] @relation("Subcategorias")
  productos      Producto[]

  @@index([categoriaPadreId])
  @@map("categorias")
}

model Producto {
  id           Int      @id @default(autoincrement())
  categoriaId  Int      @map("categoria_id")
  sku          String   @unique @db.VarChar(50)
  codigoBarras String?  @unique @map("codigo_barras") @db.VarChar(50)
  nombre       String   @db.VarChar(150)
  descripcion  String?  @db.Text
  precioCompra Decimal  @map("precio_compra") @db.Decimal(10, 2)
  precioVenta  Decimal  @map("precio_venta") @db.Decimal(10, 2)
  stock        Int      @default(0)
  stockMinimo  Int      @default(0) @map("stock_minimo")
  publicadoWeb Boolean  @default(false) @map("publicado_web")
  activo       Boolean  @default(true)
  version      Int      @default(0) // bloqueo optimista
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categoria    Categoria              @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  imagenes     ProductoImagen[]
  detalles     VentaDetalle[]
  movimientos  MovimientoInventario[]
  carritoItems CarritoItem[]

  @@index([categoriaId])
  @@index([nombre])
  @@map("productos")
}

model ProductoImagen {
  id          Int     @id @default(autoincrement())
  productoId  Int     @map("producto_id")
  url         String  @db.VarChar(500)
  orden       Int     @default(0) @db.SmallInt
  esPrincipal Boolean @default(false) @map("es_principal")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("producto_imagenes")
}

//---------

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  rol          Rol      @default(CAJERO)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  ventas      Venta[]
  movimientos MovimientoInventario[]

  @@map("usuarios")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(150)
  telefono     String   @unique @db.VarChar(20)
  email        String   @unique @db.VarChar(150)
  direccion    String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  passwordHash String?  @map("password_hash") @db.VarChar(255)

  carrito Carrito?
  ventas  Venta[]

  @@map("clientes")
}

// Venta

model Venta {
  id        Int         @id @default(autoincrement())
  usuarioId Int?        @map("usuario_id")
  clienteId Int?        @map("cliente_id") // null = venta anónima en mostrador
  folio     String      @unique @db.VarChar(20)
  canal     CanalVenta
  estado    EstadoVenta @default(PENDIENTE)
  subtotal  Decimal     @db.Decimal(10, 2)
  descuento Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  usuario     Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  cliente     Cliente?               @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  detalles    VentaDetalle[]
  pagos       Pago[]
  envio       Envio?
  movimientos MovimientoInventario[]

  @@index([usuarioId])
  @@index([clienteId])
  @@index([canal, estado])
  @@index([createdAt])
  @@map("ventas")
}

model VentaDetalle {
  id             Int     @id @default(autoincrement())
  ventaId        Int     @map("venta_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2) // snapshot
  costoUnitario  Decimal @map("costo_unitario") @db.Decimal(10, 2) // snapshot
  subtotal       Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([ventaId, productoId])
  @@index([productoId])
  @@map("venta_detalles")
}

model Pago {
  id         Int        @id @default(autoincrement())
  ventaId    Int        @map("venta_id")
  metodo     MetodoPago
  monto      Decimal    @db.Decimal(10, 2)
  referencia String?    @db.VarChar(100)
  estado     EstadoPago @default(PENDIENTE)
  fechaPago  DateTime   @default(now()) @map("fecha_pago")

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@map("pagos")
}

model Envio {
  id               Int       @id @default(autoincrement())
  ventaId          Int       @unique @map("venta_id")
  destinatario     String    @db.VarChar(150)
  telefonoContacto String    @map("telefono_contacto") @db.VarChar(20)
  direccionEntrega String    @map("direccion_entrega") @db.VarChar(255)
  referencias      String?   @db.VarChar(255)
  fechaEntrega     DateTime? @map("fecha_entrega")

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("envios")
}

model Carrito {
  id        Int      @id @default(autoincrement())
  clienteId Int      @unique @map("cliente_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id         Int @id @default(autoincrement())
  carritoId  Int @map("carrito_id")
  productoId Int @map("producto_id")
  cantidad   Int

  carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([carritoId, productoId])
  @@map("carrito_items")
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int            @map("producto_id")
  usuarioId       Int?           @map("usuario_id")
  ventaId         Int?           @map("venta_id")
  tipo            TipoMovimiento
  cantidad        Int // + entra / - sale
  stockAnterior   Int            @map("stock_anterior")
  stockResultante Int            @map("stock_resultante")
  motivo          String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  venta    Venta?   @relation(fields: [ventaId], references: [id], onDelete: SetNull)

  @@index([productoId, createdAt])
  @@index([ventaId])
  @@map("movimientos_inventario")
}
